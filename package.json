{
  "name": "commitment-ledger-genlayer",
  "version": "3.0.0",
  "description": "CommitmentLedger Intelligent Contract on GenLayer: tracking public commitments with consensus-verified semantic matching against paraphrase-dodging",
  "type": "commonjs",
  "scripts": {
    "test": "python -m unittest discover tests",
    "scan:ascii": "python scripts/scan_ascii.py",
    "scan:banned": "python scripts/scan_banned_words.py",
    "scan:secrets": "python scripts/scan_secrets.py",
    "check:evidence": "python scripts/check_evidence_consistency.py",
    "verify:source": "node scripts/verify_source.js",
    "deploy": "node scripts/deploy/deploy.js",
    "evidence": "node scripts/deploy/run_evidence.js",
    "decode:revert": "node scripts/tools/decode_revert.js",
    "read:commitment": "node scripts/tools/read_commitment.js",
    "render:evidence": "node scripts/tools/render_evidence_md.js",
    "check": "npm run test && npm run scan:ascii && npm run scan:banned && npm run scan:secrets && npm run check:evidence"
  },
  "keywords": [
    "genlayer",
    "intelligent-contracts",
    "accountability",
    "semantic-matching",
    "commitment-ledger"
  ],
